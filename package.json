{
  "name": "homebridge-octopus-energy-live",
  "displayName": "Octopus Energy Live",
  "version": "0.6.1",
  "description": "Display Octopus Energy electricity and gas smart meter data through Homebridge",
  "author": {
    "name": "lxmitch",
    "url": "https://github.com/Ai-Lampy"
  },
  "contributors": [
    {
      "name": "IcebondX",
      "url": "https://github.com/icebondx"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ai-Lampy/homebridge-octopus-energy-live.git"
  },
  "homepage": "https://github.com/Ai-Lampy/homebridge-octopus-energy-live#readme",
  "bugs": {
    "url": "https://github.com/Ai-Lampy/homebridge-octopus-energy-live/issues"
  },
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/lxmitch"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "assets/config-header.svg",
    "assets/plugin-icon.png",
    "config.schema.json",
    "CHANGELOG.md"
  ],
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "supports-matter",
    "octopus",
    "energy",
    "electricity",
    "gas",
    "homekit",
    "octopus-energy",
    "live-energy",
    "smart-meter",
    "eve",
    "power-monitoring"
  ],
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.2.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "watch": "tsc -w -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test"
  },
  "homebridge": {
    "platforms": [
      {
        "platform": "OctopusEnergyLive",
        "name": "Octopus Energy Live"
      }
    ]
  },
  "dependencies": {
    "node-fetch": "^2.6.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "homebridge": "^2.4.0",
    "@types/node": "^26.5.1",
    "@types/node-fetch": "^2.6.11",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.4.5"
  }
}
